<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <!-- Add any data binding variables here if necessary -->
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_card"
        android:backgroundTint="@color/schemes_surface"
        android:padding="12dp">

        <!-- Icon (like a map icon) -->
        <ImageView
            android:id="@+id/iconLocation"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="test"
            android:src="@drawable/ic_maps"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/parkingName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Estacionamento dos And..."
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iconLocation"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Parking address -->
        <TextView
            android:id="@+id/parkingAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="Rua dos Tupis, 118 - Centro, Belo Horizonte"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/iconLocation"
            app:layout_constraintTop_toBottomOf="@id/parkingName" />

        <!-- Reservation date -->
        <TextView
            android:id="@+id/reservationDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="Terça feira, 14 de Agosto"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/iconLocation"
            app:layout_constraintTop_toBottomOf="@id/parkingAddress" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
